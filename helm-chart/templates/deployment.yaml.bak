apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "inventory-app.fullname" . | trunc 63 }}
  labels:
    app.kubernetes.io/name: {{ include "inventory-app.name" . }}
    helm.sh/chart: {{ include "inventory-app.chart" . }}
    app.kubernetes.io/instance: {{ .Release.Name }}
spec:
  replicas: {{ .Values.replicaCount }}
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ .Release.Name }}
      app.kubernetes.io/name: {{ include "inventory-app.name" . }}
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ .Release.Name }}
        app.kubernetes.io/name: {{ include "inventory-app.name" . }}
    spec:
      # Do not force runAsUser (OpenShift will assign arbitrary UID)
      securityContext:
        fsGroup: 1000
      containers:
        - name: {{ include "inventory-app.name" . }}
          image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
          imagePullPolicy: {{ .Values.image.pullPolicy }}
          ports:
            - containerPort: {{ .Values.service.targetPort }}
              name: http
          env:
            - name: APP_ENV
              value: "{{ .Values.env.APP_ENV }}"
            - name: APP_DEBUG
              value: "{{ .Values.env.APP_DEBUG }}"
            - name: APP_KEY
              valueFrom:
                secretKeyRef:
                  name: {{ include "inventory-app.fullname" . }}
                  key: APP_KEY
            - name: DB_CONNECTION
              value: "{{ .Values.env.DB_CONNECTION }}"
            - name: DB_HOST
              value: "{{ .Values.env.DB_HOST }}"
            - name: DB_PORT
              value: '{{ printf "%d" .Values.env.DB_PORT }}'
            - name: DB_DATABASE
              value: "{{ .Values.env.DB_DATABASE }}"
            - name: DB_USERNAME
              value: "{{ .Values.env.DB_USERNAME }}"
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ include "inventory-app.fullname" . }}
                  key: DB_PASSWORD
            - name: PORT
              value: "{{ .Values.service.targetPort }}"
          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 30
            periodSeconds: 20
          volumeMounts:
            - name: storage
              mountPath: /var/www/html/storage
            - name: cache
              mountPath: /var/www/html/bootstrap/cache
      volumes:
        - name: storage
          persistentVolumeClaim:
            claimName: {{ include "inventory-app.fullname" . }}-pvc
        - name: cache
          emptyDir: {}
